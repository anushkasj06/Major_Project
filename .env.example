# ═══════════════════════════════════════════════
# ARAMBH — Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════

# ─── MongoDB ───────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=arambh_secret_change_me
MONGODB_URL=mongodb://admin:arambh_secret_change_me@localhost:27017/arambh?authSource=admin
MONGODB_DB_NAME=arambh

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ─── Qdrant ────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=arambh_docs

# ─── JWT / Auth ────────────────────────────────
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth (optional) ───────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── AI APIs ───────────────────────────────────
# Get free key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI fallback
OPENAI_API_KEY=

# ─── Embedding Model ───────────────────────────
# Uses HuggingFace — no API key needed, runs locally
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Alternatively: BAAI/bge-small-en-v1.5 (better quality)

# ─── LLM Configuration ─────────────────────────
PRIMARY_LLM_PROVIDER=gemini
PRIMARY_LLM_MODEL=gemini-1.5-flash
FALLBACK_LLM_PROVIDER=groq
FALLBACK_LLM_MODEL=llama-3.1-8b-instant
MAX_TOKENS=2048
TEMPERATURE=0.1

# ─── RAG Configuration ─────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
RERANK_TOP_K=3
MIN_CONFIDENCE_SCORE=0.5
HYBRID_SEARCH_ALPHA=0.5

# ─── Crawler Configuration ─────────────────────
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES_PER_SITE=100
CRAWLER_RATE_LIMIT_DELAY=2.0
CRAWLER_CONCURRENT_REQUESTS=5
CRAWLER_TIMEOUT=30
USER_AGENT=ArambhBot/1.0 (Educational Research Crawler)

# ─── Services ──────────────────────────────────
BACKEND_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8001
CRAWLER_SERVICE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# ─── File Storage ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,csv

# ─── CORS ──────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Feature Flags ─────────────────────────────
ENABLE_SPEECH_INPUT=false
ENABLE_MULTILINGUAL=true
ENABLE_GOOGLE_OAUTH=false
ENABLE_EVALUATION=true
